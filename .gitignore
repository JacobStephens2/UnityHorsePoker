*.apk
*.aab
*.unitypackage
*.app

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Crashlytics
crashlytics-build.properties

# Unity Android IL2CPP/Gradle build cache
.utmp/

# MCP debug screenshots
Assets/Screenshots/
Assets/Screenshots.meta
